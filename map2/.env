# ============================================================
# Enterprise Drone & Satellite Image Processing Platform
# Environment Configuration
# Classification: Confidential — Internal Use Only
# ============================================================

# --------------------------------------------------

# --------------------------------------------------
# PostgreSQL / PostGIS
# --------------------------------------------------
POSTGRES_USER=map_admin
POSTGRES_PASSWORD=map_admin_pass
POSTGRES_DB=map_core
DATABASE_URL=postgresql://map_admin:map_admin_pass@postgres:5432/map_core?schema=public

# --------------------------------------------------
# Redis (Cache + Celery Broker + Pub/Sub)
# --------------------------------------------------
REDIS_URL=redis://redis:6379

# --------------------------------------------------
# RabbitMQ (Guaranteed Delivery Event Bus)
# --------------------------------------------------
RABBITMQ_URL=amqp://map_mq:map_mq_pass@rabbitmq:5672
RABBITMQ_DEFAULT_USER=map_mq
RABBITMQ_DEFAULT_PASS=map_mq_pass

# --------------------------------------------------
# MinIO (S3-Compatible Object Storage)
# --------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_API_CORS_ORIGIN="*"

# --------------------------------------------------
# NodeODM (Photogrammetry Engine)
# --------------------------------------------------
NODEODM_URL=http://nodeodm:3000

# --------------------------------------------------
# Celery
# --------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --------------------------------------------------
# SentinelHub (Copernicus Data Space)
# --------------------------------------------------
# To use SentinelHub, sign up at https://dataspace.copernicus.eu/
# and create an OAuth client. 
