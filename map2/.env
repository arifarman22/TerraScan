SENTINELHUB_CLIENT_SECRET=Btnfmg2JCYSRBFHmNMJ5UJ5MP3PcHa61

# --------------------------------------------------
# Google Earth Engine (Service Account)
# --------------------------------------------------
GEE_SERVICE_ACCOUNT=/app/clawapp-mail-097f5238110b.json

