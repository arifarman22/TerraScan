{
  "name": "@platform/core-service",
  "version": "0.1.0",
  "private": true,
  "description": "Core Management Service — identity, RBAC, tenants, projects, missions, jobs (SRS v2.0)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/database/data-source.js",
    "migration:show": "typeorm migration:show -d dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.23",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.23",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.23",
    "@nestjs/platform-socket.io": "11.1.23",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/typeorm": "11.0.1",
    "@nestjs/websockets": "11.1.23",
    "@node-rs/argon2": "2.0.2",
    "@platform/shared-types": "*",
    "amqplib": "^0.10.5",
    "otplib": "12.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "exifr": "7.1.3",
    "helmet": "8.2.0",
    "ioredis": "5.10.1",
    "minio": "8.0.7",
    "pg": "8.21.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "typeorm": "1.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "socket.io-client": "4.8.3",
    "typescript": "^5.7.0"
  }
}
