# ============================================================
# Enterprise Drone & Satellite Image Processing Platform
# Environment Configuration — TEMPLATE
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Classification: Confidential — Internal Use Only
# ============================================================

# ------------------------------------------------------------
# GLOBAL
# ------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
# Public base URL of the platform (API gateway / host shell).
PLATFORM_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# PostgreSQL 17 + PostGIS 3.5
# ------------------------------------------------------------
POSTGRES_USER=map_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=map_core
POSTGRES_PORT=5432
# Connection string used by Core Service (TypeORM). Host = compose service name.
DATABASE_URL=postgresql://map_admin:CHANGE_ME_strong_db_password@postgres:5432/map_core?schema=public
# Least-privilege runtime role (created by Phase 1 migrations) — SRS NFR-SEC-010.
DATABASE_APP_USER=map_app
DATABASE_APP_PASSWORD=CHANGE_ME_strong_app_password

# ------------------------------------------------------------
# Redis 8 — cache, sessions, Celery broker, pub/sub
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
# Required by docker-compose.prod.yml. Leave empty for local development.
REDIS_PASSWORD=

# ------------------------------------------------------------
# RabbitMQ 4.1 — durable event bus
# ------------------------------------------------------------
RABBITMQ_DEFAULT_USER=map_mq
RABBITMQ_DEFAULT_PASS=CHANGE_ME_strong_mq_password
RABBITMQ_URL=amqp://map_mq:CHANGE_ME_strong_mq_password@rabbitmq:5672
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ------------------------------------------------------------
# MinIO — S3-compatible object storage
# ------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
# Explicit allow-list — never "*" in production (SRS NFR-SEC-009 / FR-API-007).
MINIO_API_CORS_ORIGIN=http://localhost:3000
# Pinned RELEASE tag for the production image (docker-compose.prod.yml).
MINIO_RELEASE=latest
# Logical buckets created automatically by infra/docker-compose.yml `minio-init`.
MINIO_BUCKET_RAW=platform-raw
MINIO_BUCKET_PROCESSED=platform-processed
MINIO_BUCKET_REPORTS=platform-reports
MINIO_BUCKET_EXPORTS=platform-exports

# ------------------------------------------------------------
# NodeODM — photogrammetry engine
# ------------------------------------------------------------
NODEODM_URL=http://nodeodm:3000
NODEODM_PORT=3000

# ------------------------------------------------------------
# Celery — distributed task workers
# ------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------
# Core Service — authentication & JWT (SRS §5)
# Generate each secret with: openssl rand -hex 32
# ------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_64_hex_characters
JWT_REFRESH_SECRET=CHANGE_ME_different_64_hex_characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
MFA_ISSUER=DroneSatPlatform

# ------------------------------------------------------------
# SentinelHub / Copernicus Data Space (SRS FR-INT-001)
# Sign up: https://dataspace.copernicus.eu/
# ------------------------------------------------------------
SENTINELHUB_CLIENT_ID=CHANGE_ME_sentinelhub_client_id
SENTINELHUB_CLIENT_SECRET=CHANGE_ME_sentinelhub_client_secret
SENTINELHUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# ------------------------------------------------------------
# Google Earth Engine — service account (SRS FR-INT-002)
# In production load this key from a secrets manager, not a file.
# ------------------------------------------------------------
GEE_SERVICE_ACCOUNT=/run/secrets/gee-service-account.json
GEE_PROJECT_ID=CHANGE_ME_gee_project_id

# ------------------------------------------------------------
# Planet Labs API (SRS FR-INT-003)
# Sign up: https://www.planet.com/
# ------------------------------------------------------------
PLANET_API_KEY=CHANGE_ME_planet_api_key
PLANET_ACCOUNT_ID=CHANGE_ME_planet_account_id
PLANET_USER_ID=CHANGE_ME_planet_user_id

# ------------------------------------------------------------
# Service ports
# NOTE: drone & satellite services use distinct host ports
# (the original config collided both on 8000 — SRS Appendix B, B9).
# ------------------------------------------------------------
CORE_SERVICE_PORT=3001
DRONE_SERVICE_PORT=8000
SATELLITE_SERVICE_PORT=8010
ML_SERVICE_PORT=8020
HOST_SHELL_PORT=3000
MFE_DASHBOARD_PORT=3002
MFE_VIEWER_PORT=3003

# ------------------------------------------------------------
# Frontend (public — exposed to the browser, must contain no secrets)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_MFE_DASHBOARD_URL=http://localhost:3002
NEXT_PUBLIC_MFE_VIEWER_URL=http://localhost:3003

# ------------------------------------------------------------
# Observability (SRS §19.7)
# ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=drone-sat-platform
PROMETHEUS_METRICS_ENABLED=true
